{
  "name": "ba-studio-v3-8-erp-solution-intelligence",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "description": "BA Studio v3.8 - ERP BA domain and Build/Adopt/Hybrid evaluation with human-backed Fit-Gap",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "doctor": "node scripts/doctor.mjs",
    "doctor:figma": "node scripts/doctor.mjs --figma",
    "eval": "node scripts/evaluate.mjs",
    "eval:harness2": "node --test tests/harness2-runtime.test.js && node scripts/harness2.mjs test",
    "benchmark:harness2": "node scripts/harness2.mjs run",
    "benchmark:harness2:live": "node scripts/harness2-live.mjs",
    "eval:harness2:live": "node --test tests/harness2-live.test.js && node scripts/harness2.mjs live-test",
    "setup": "node scripts/bootstrap.mjs",
    "setup:start": "node scripts/bootstrap.mjs --start",
    "eval:prompts": "node scripts/evaluate-prompts.mjs",
    "eval:semantic": "node scripts/evaluate-semantic.mjs",
    "eval:workflow": "node --test tests/v32-workflow.test.js",
    "worker": "node scripts/worker.mjs",
    "backup": "node scripts/backup.mjs",
    "eval:production": "node --test tests/v33-production.test.js",
    "eval:quality": "node scripts/evaluate-quality.mjs",
    "eval:figma-contract": "node scripts/evaluate-figma-contract.mjs",
    "eval:v34": "node --test tests/v34-quality.test.js",
    "eval:live-acceptance": "node scripts/live-acceptance.mjs",
    "eval:figma-crosscheck": "node scripts/figma-crosscheck.mjs",
    "eval:live-tests": "node --test tests/v34-live-acceptance.test.js tests/v34-live-cli.test.js",
    "test:serial": "node --test --test-concurrency=1 tests/*.test.js",
    "session:bootstrap": "node scripts/session-continuity.mjs bootstrap",
    "session:new": "node scripts/session-continuity.mjs new",
    "session:checkpoint": "node scripts/session-continuity.mjs checkpoint",
    "session:resume": "node scripts/session-continuity.mjs resume",
    "session:handoff": "node scripts/session-continuity.mjs handoff",
    "session:verify": "node scripts/session-continuity.mjs verify",
    "session:status": "node scripts/session-continuity.mjs status",
    "session:history": "node scripts/session-continuity.mjs history",
    "session:finish": "node scripts/session-continuity.mjs finish",
    "session:context": "node scripts/session-continuity.mjs context",
    "eval:continuity": "node --test tests/v35-session-continuity.test.js",
    "project:migrate": "node scripts/project-workspaces.mjs migrate",
    "project:status": "node scripts/project-workspaces.mjs status",
    "eval:workspaces": "node --test tests/v36-project-workspaces.test.js",
    "eval:recommendations": "node --test tests/v37-clarification-recommendations.test.js",
    "eval:erp": "node --test tests/v38-erp-intelligence.test.js",
    "project:purge": "node scripts/project-purge.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "saxes": "6.0.0"
  }
}
