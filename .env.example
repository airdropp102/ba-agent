# Demo (offline sample) or AI backend: demo | codex | openai
DEMO_MODE=true
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Codex CLI uses existing logged-in ChatGPT account, not API key.
# Optional: explicit model override; omit to use your Codex CLI default.
# CODEX_MODEL=your-available-codex-model
CODEX_TIMEOUT_MS=300000
# Figma publish can take longer; independent limit, capped at 10 minutes.
CODEX_FIGMA_TIMEOUT_MS=600000
# Console metadata only: phases, IDs, counts and CLI heartbeat every 15 seconds.
BA_LOG_PROGRESS=true
# CODEX_BIN=codex
HOST=127.0.0.1
PORT=3478
# Required only when binding to 0.0.0.0 or external interface (min 32 chars).
# BA_STUDIO_TOKEN=

# v3.3 production (Node >=22.13; local filesystem, not NFS)
# DATA_DIR=./data
# BA_JOB_POLL_MS=1500
# BA_WORKER_ENABLED=true
# For separate HTTP + worker: HTTP process BA_WORKER_ENABLED=false; npm run worker in a second process
# REQUIRE_REVIEWER_IDENTITY=true
# BA_REVIEWER_TOKENS_JSON={"reviewer-1":"set-a-random-32+-character-secret"}
# BA_STUDIO_REVIEWER_TOKEN=... (optional operator CLI read-back)
# REQUIRE_IF_MATCH=true

# v3.4 Quality Intelligence — opt-in hard gate; 0.8 = 80% weighted proxy
# BA_QUALITY_ENFORCE=false
# BA_QUALITY_MIN_SCORE=0.8
# AI cost telemetry: prices manually verified by operator, USD per 1M tokens.
# BA_AI_COST_RATES_JSON={"gpt-4.1-mini":{"inputPerMillionUsd":0,"outputPerMillionUsd":0}}
# Do NOT use example zero rates in production. Omit config to mark cost UNKNOWN.
# BA_AI_ALERT_RUN_USD=10

# v3.4 Live Acceptance (operator-only; never commit .env or review bundles)
# Real, anonymized, BA-adjudicated 20..50 case corpus required to run.
# Explicit --confirm-external-processing flag required for live provider calls.
# Figma independent read-only REST cross-check (PAT with file_content:read, separate from Codex MCP)
# FIGMA_ACCESS_TOKEN=your-read-only-figma-personal-access-token

# Limit agent session continuity bootstrap to one BA project (UUID).
# BA_ACTIVE_PROJECT_ID=

# Local Figma plugin relay. The bundled protocol relay listens on loopback only.
# Install Bun or set this to its trusted absolute executable path.
BUN_BIN=bun
FIGMA_RELAY_HOST=127.0.0.1
FIGMA_RELAY_PORT=3055

# Enable only after explicit operator approval for the fixed BA Studio Figma tool list.
CODEX_FIGMA_TOOL_APPROVAL=false
