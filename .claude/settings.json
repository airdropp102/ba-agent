{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 15,
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/session-hook.mjs",
              "SessionStart"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 15,
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/session-hook.mjs",
              "PreCompact"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 15,
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/session-hook.mjs",
              "Stop"
            ]
          }
        ]
      }
    ]
  }
}
